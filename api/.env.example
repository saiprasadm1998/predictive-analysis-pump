# Copy to .env (git-ignored) and fill in.
PORT=4000
ML_URL=http://127.0.0.1:8000
JWT_SECRET=change-me-to-a-long-random-string
# Created on first start only, when there are no users yet.
ADMIN_USER=operator
ADMIN_PASS=change-this-password
# Optional: JSON file naming the component behind each sensor, used in suggested actions. See sensor-map.example.json.
# SENSOR_MAP=sensor-map.json
