# Copy to .env (git-ignored) and fill in.
PORT=4000
ML_URL=http://127.0.0.1:8000
JWT_SECRET=change-me-to-a-long-random-string
# MongoDB Atlas connection string. Leave empty to use the in-memory store.
MONGODB_URI=
MONGODB_DB=pump_guardian
# Created on first start only, when the users collection is empty.
ADMIN_USER=operator
ADMIN_PASS=change-this-password
